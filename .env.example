# CSE VIYUGAM Dashboard - Environment Configuration

# Server Port
PORT=5000

# Google Spreadsheet ID (Source of Truth)
# Sheet URL: https://docs.google.com/spreadsheets/d/1doXrCIk2H2UscjpXf6xEa3PDU6uco9KjzMWiF_vG-xc/edit?usp=sharing
GOOGLE_SPREADSHEET_ID=1doXrCIk2H2UscjpXf6xEa3PDU6uco9KjzMWiF_vG-xc

# Optional Worksheet Range or Name (Default: Sheet1)
GOOGLE_SHEET_RANGE=Sheet1!A1:Z500

# Optional Google API Key (For Google Sheets API v4)
GOOGLE_API_KEY=

# Optional Google Service Account Credentials (For private sheets)
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
